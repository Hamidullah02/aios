# Coverage profile artifacts (regenerable from `go test -coverprofile`)
*.out
*.cover
*.coverprofile

# Test artifacts (test run output, not source)
var/checkpoints/
internal/**/var/

# One-off audit scripts (created for a specific doc-audit pass;
