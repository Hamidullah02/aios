# Coverage profile artifacts (regenerable from `go test -coverprofile`)
*.out
*.cover
*.coverprofile

# Local secrets. A .env file holds API keys, and a key that
# reaches a commit is a key that has to be rotated.
.env
.env.*

# Local test-run transcripts. These are console output written
# during a local `go test` pass, not source. The .gitignore
# patterns for *.out / *.cover do not cover a plain .txt, so
# they were swept into a commit by accident.
gotest.txt
tcount.txt
final_test.txt
test-output.txt

# Test artifacts (test run output, not source)
var/
var/checkpoints/
var/aios.log
var/aios.db
var/aios-daemon.pid
var/aios-approval.sock
internal/**/var/

# One-off audit scripts (created for a specific doc-audit pass;
# safe to delete; not part of the build / test workflow).
where.ps1
untracked.ps1
untracked-all.ps1
ls-files.ps1
cat-gi.ps1
git-state.ps1
git-state2.ps1
diff-stat.ps1
diff-readme.ps1
diff-mem.ps1
list-docs.ps1
list-docs2.ps1
list-docs3.ps1
list-modules.ps1
inv.ps1
req-count.ps1
show-req.ps1
show-req2.ps1
show-req3.ps1
show-req4.ps1
check-ignored.ps1
check-ignore.ps1
untrack.ps1
ls-ps1.ps1

# Test runner scripts we keep. Any other *.ps1 in the
# project root is a one-off throwaway from a specific
# audit or debug pass; ignore them so they don't get
# added by a future commit.
*.ps1
!test-*.ps1
!vet-fmt.ps1

# The Windows installer. It is a *.ps1, so the rule above
# would ignore it -- and an installer that is not in the
# repository is an installer nobody can download.
!install.ps1
